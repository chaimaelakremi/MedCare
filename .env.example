# Copy to .env and run: flutter run --dart-define-from-file=.env
# .env is git-ignored. Without a key, the app runs with the AI scanner disabled.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional: override the Gemini model used by the prescription scanner
# GEMINI_MODEL=gemini-2.5-flash
